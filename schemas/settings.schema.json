{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nucleoos/settings.schema.json",
  "title": "NucleoOS System Settings",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "device", "network", "power", "ui", "security"],
  "properties": {
    "schema": { "type": "integer", "minimum": 1 },
    "device": {
      "type": "object",
      "required": ["name", "locale"],
      "properties": {
        "name": { "type": "string" },
        "locale": { "type": "string" },
        "timezone": { "type": "string" }
      }
    },
    "network": {
      "type": "object",
      "properties": {
        "wifi": { "type": "object" },
        "ble": { "type": "object" },
        "swarm": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "channel": { "type": "integer", "minimum": 0, "maximum": 14 },
            "name": { "type": "string", "maxLength": 32 },
            "passphrase": { "type": "string", "maxLength": 63 },
            "peers": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "power": {
      "type": "object",
      "properties": {
        "profile": { "type": "string", "enum": ["eco", "balanced", "performance"] },
        "sleep_timeout_s": { "type": "integer", "minimum": 0 },
        "display_brightness": { "type": "integer", "minimum": 0 },
        "transport_profile": { "type": "string", "enum": ["auto", "wifi", "ble", "swarm", "usb"] }
      }
    },
    "ui": {
      "type": "object",
      "properties": {
        "theme": { "type": "string" },
        "default_transport": { "type": "string", "enum": ["auto", "wifi", "ble", "usb"] },
        "keyboard_mouse_first": { "type": "boolean" }
      }
    },
    "security": {
      "type": "object",
      "properties": {
        "require_pairing": { "type": "boolean" },
        "verify_bundle_signatures": { "type": "boolean" }
      }
    },
    "assistant": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "lang": { "type": "string", "enum": ["it", "en"] },
        "tier_max": { "type": "string", "enum": ["command", "fact", "stitch", "remote"] }
      }
    },
    "display": {
      "type": "object",
      "description": "External SPI display on the Cardputer ADV EXT header (docs/external-display.md). Absent = auto-detect with the documented wiring.",
      "additionalProperties": false,
      "properties": {
        "external": { "type": "string", "enum": ["auto", "on", "off"] },
        "external_controller": { "type": "string", "enum": ["auto", "ili9341", "st7789"] },
        "external_rotation": { "type": "integer", "enum": [1, 3] },
        "external_mhz": { "type": "integer", "minimum": 1, "maximum": 40 },
        "external_mirror": { "type": "boolean" },
        "external_invert": { "type": "boolean" },
        "external_rgb": { "type": "boolean" },
        "external_diag": { "type": "boolean" },
        "external_pins": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cs": { "type": "integer", "minimum": -1, "maximum": 48 },
            "dc": { "type": "integer", "minimum": -1, "maximum": 48 },
            "rst": { "type": "integer", "minimum": -1, "maximum": 48 },
            "t_cs": { "type": "integer", "minimum": -1, "maximum": 48 },
            "t_irq": { "type": "integer", "minimum": -1, "maximum": 48 },
            "bl": { "type": "integer", "minimum": -1, "maximum": 48 }
          }
        }
      }
    }
  }
}
