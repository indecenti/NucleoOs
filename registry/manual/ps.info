  "en": {
    "title": "ps - List apps as a process table",
    "synopsis": "ps",
    "description": "Shows the installed, enabled apps with a run state. On a device that runs one foreground app plus the shell, this is the closest thing to a process list.",
    "details": "NAME\n  ps - List apps as a process table\n\nSYNOPSIS\n  ps\n\nDESCRIPTION\n  Shows the installed, enabled apps with a run state. On a device that runs one foreground app plus the shell, this is the closest thing to a process list.\n\nOPTIONS\n  No options. The PID shown is synthetic and renumbers on every listing: to act on an app use its id with kill(1).\n\nDEVICE COST\n  one app-table read, cached 30s\n\nSEE ALSO\n  kill(1), apps(1)\n\nEXAMPLES\n  ps\n  ps | grep run"
  }
}
