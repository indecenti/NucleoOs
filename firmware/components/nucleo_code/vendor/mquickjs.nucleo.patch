--- a/mquickjs.c
+++ b/mquickjs.c
@@ -222,6 +222,7 @@
     uint16_t class_count; /* number of classes including user classes */
     int16_t interrupt_counter;
     BOOL current_exception_is_uncatchable : 8;
+    uint32_t nucleo_live_max; /* NUCLEO PATCH: the most memory live after a GC (heap + stack), bytes */
     struct JSParseState *parse_state; /* != NULL during JS_Eval() */
     int unique_strings_len;
     int js_call_rec_count; /* number of recursing JS_Call() */
@@ -12519,7 +12520,21 @@
 void JS_GC(JSContext *ctx)
 {
     JS_GC2(ctx, TRUE);
+    {   /* NUCLEO PATCH: after a compacting GC, heap_free - heap_base is what is live; add the stack */
+        uint32_t live = (uint32_t)(ctx->heap_free - ctx->heap_base) + (uint32_t)(ctx->stack_top - (uint8_t *)ctx->sp);
+        if (live > ctx->nucleo_live_max) ctx->nucleo_live_max = live;
+    }
+}
+
+/* NUCLEO PATCH: memory figures for the host (docs/nucleo-code.md 8): the most live after a GC, and now. */
+uint32_t JS_NucleoLiveMax(JSContext *ctx) { return ctx->nucleo_live_max; }
+uint32_t JS_NucleoUsedNow(JSContext *ctx)
+{
+    return (uint32_t)(ctx->heap_free - ctx->heap_base) + (uint32_t)(ctx->stack_top - (uint8_t *)ctx->sp);
 }
+/* NUCLEO PATCH: poll the interrupt handler at the next instruction, not after up to 10000 (a script that spends
+   its time in C - drawing, sleeping - would otherwise see Esc or its time limit seconds late) */
+void JS_NucleoInterruptSoon(JSContext *ctx) { ctx->interrupt_counter = 1; }
 
