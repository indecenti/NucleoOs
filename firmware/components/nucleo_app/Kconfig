menu "NucleoOS apps"

menu "Games that ship from the store"
    comment "Each one left out of the image becomes the native app of the same id in the store (docs/native-apps.md)."
    comment "On by default: these games are installed from the Store (Native C)."

config NUCLEO_STORE_CONSTELLATIONS
    bool "Constellations (stelle): from the store, not in the firmware"
    default y
    help
        Leaves app_constellations.cpp out of the firmware image (about 68 KB). The web Game Center's
        cross-play save endpoint is not available while the game ships from the store.

config NUCLEO_STORE_POKER
    bool "Poker (poker): from the store, not in the firmware"
    default y
    help
        Leaves app_poker.cpp out of the firmware image.

config NUCLEO_STORE_TANKS
    bool "Tanks (tanks): from the store, not in the firmware"
    default y
    help
        Leaves app_tanks.cpp out of the firmware image (about 70 KB).

endmenu

endmenu
