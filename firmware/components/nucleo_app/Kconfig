config NUCLEO_STORE_SANDGARDEN
    bool "Garden (giardino): from the store, not in the firmware"
    default y
    help
        Leaves app_sandgarden.cpp out of the firmware image.

config NUCLEO_STORE_PONG
    bool "Pong (pong): from the store, not in the firmware"
    default y
