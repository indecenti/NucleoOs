menu "NucleoOS apps"

menu "Games that ship from the store"
    comment "Each one left out of the image becomes the native app of the same id in the store (docs/native-apps.md)."
    comment "On by default: these games are installed from the Store (Native C)."

config NUCLEO_STORE_CONSTELLATIONS
    bool "Constellations (stelle): from the store, not in the firmware"
    default y
    help
        Leaves app_constellations.cpp out of the firmware image (about 68 KB). The web Game Center's
        cross-play save endpoint is not available while the game ships from the store.

config NUCLEO_STORE_POKER
    bool "Poker (poker): from the store, not in the firmware"
    default y
    help
        Leaves app_poker.cpp out of the firmware image.

config NUCLEO_STORE_TANKS
    bool "Tanks (tanks): from the store, not in the firmware"
    default y
    help
        Leaves app_tanks.cpp out of the firmware image (about 70 KB).

config NUCLEO_STORE_TANKDUEL
    bool "Tank Duel (tankd): from the store, not in the firmware"
    default y
    help
        Leaves app_tankduel.cpp out of the firmware image (about 47 KB).

config NUCLEO_STORE_BRAWLER
    bool "Brawler (brawler): from the store, not in the firmware"
    default y
    help
        Leaves app_brawler.cpp and brawler_*.cpp out of the firmware image.

config NUCLEO_STORE_PINBALL
    bool "Pinball (pinball): from the store, not in the firmware"
    default y
    help
        Leaves app_pinball.cpp out of the firmware image.

config NUCLEO_STORE_CARDLER
    bool "Cardler (cardler): from the store, not in the firmware"
    default y
    help
        Leaves app_cardler.cpp out of the firmware image.

config NUCLEO_STORE_ORDE
    bool "Orde (orde): from the store, not in the firmware"
    default y
    help
        Leaves app_vs.cpp and vs_sim.c out of the firmware image.

config NUCLEO_STORE_SNAKE
    bool "Snake (snake): from the store, not in the firmware"
    default y
    help
        Leaves app_snake.cpp out of the firmware image.

config NUCLEO_STORE_SLOTS
    bool "Slots (slots): from the store, not in the firmware"
    default y
    help
        Leaves app_slots.cpp out of the firmware image.

