 #define WALNUT_GB_RGB565_BIGENDIAN 0
+#endif
 uint8_t __gb_read(struct gb_s *gb, uint16_t addr);
 void __gb_write(struct gb_s *gb, uint_fast16_t addr, uint8_t val);
