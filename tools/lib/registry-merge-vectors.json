{
  "_comment": "Shared cases for the apps.json merge rule (tools/lib/registry-merge.mjs, sd_deploy.py merge_registry_text, and the device installer). release/device are JSON TEXT (device null = no file). expect.installed lists the resulting ids in order; expect.same_as_release = the output must be the release text byte-exact.",
  "cases": [
    { "name": "no device file", "release": "{\n  \"schema\": 1,\n  \"installed\": [\n    {\n      \"id\": \"notepad\",\n      \"enabled\": true\n    }\n  ]\n}\n",
      "device": null,
      "expect": { "installed": ["notepad"], "kept": [], "shadowed": [], "deviceReadable": false, "same_as_release": true } },
    { "name": "device equals an older release, no agent apps",
      "release": "{\n  \"schema\": 1,\n  \"installed\": [\n    {\n      \"id\": \"notepad\",\n      \"enabled\": true\n    },\n    {\n      \"id\": \"clock\",\n      \"enabled\": true\n    }\n  ]\n}\n",
      "device": "{\"schema\":1,\"installed\":[{\"id\":\"notepad\",\"enabled\":true}]}",
      "expect": { "installed": ["notepad", "clock"], "kept": [], "shadowed": [], "deviceReadable": true, "same_as_release": true } },
    { "name": "agent app carried over unchanged, after the release entries",
      "release": "{\n  \"schema\": 1,\n  \"installed\": [\n    {\n      \"id\": \"notepad\",\n      \"enabled\": true\n    }\n  ]\n}\n",
      "device": "{\"schema\":1,\"installed\":[{\"id\":\"mine\",\"version\":\"0.2.0\",\"path\":\"/apps/mine\",\"enabled\":false,\"created_by\":\"agent\",\"permissions\":[\"storage.app\"]},{\"id\":\"notepad\",\"enabled\":false}]}",
      "expect": { "installed": ["notepad", "mine"], "kept": ["mine"], "shadowed": [], "deviceReadable": true, "same_as_release": false,
                  "entry": { "id": "mine", "version": "0.2.0", "path": "/apps/mine", "enabled": false, "created_by": "agent", "permissions": ["storage.app"] },
                  "text": "{\n  \"schema\": 1,\n  \"installed\": [\n    {\n      \"id\": \"notepad\",\n      \"enabled\": true\n    },\n    {\n      \"id\": \"mine\",\n      \"version\": \"0.2.0\",\n      \"path\": \"/apps/mine\",\n      \"enabled\": false,\n      \"created_by\": \"agent\",\n      \"permissions\": [\n        \"storage.app\"\n      ]\n    }\n  ]\n}\n" } },
    { "name": "agent app shadowed by a system app with the same id",
      "release": "{\"schema\":1,\"installed\":[{\"id\":\"notepad\",\"enabled\":true},{\"id\":\"weather\",\"enabled\":true}]}",
      "device": "{\"schema\":1,\"installed\":[{\"id\":\"weather\",\"created_by\":\"agent\",\"enabled\":true}]}",
      "expect": { "installed": ["notepad", "weather"], "kept": [], "shadowed": ["weather"], "deviceReadable": true, "same_as_release": true } },
    { "name": "malformed device file carries nothing over",
      "release": "{\"schema\":1,\"installed\":[{\"id\":\"notepad\",\"enabled\":true}]}",
      "device": "{\"schema\":1,\"installed\":[{\"id\":\"mine\",\"created_by\":\"agent\"",
      "expect": { "installed": ["notepad"], "kept": [], "shadowed": [], "deviceReadable": false, "same_as_release": true } },
    { "name": "device without an installed array is unreadable",
      "release": "{\"schema\":1,\"installed\":[{\"id\":\"notepad\",\"enabled\":true}]}",
      "device": "{\"schema\":1}",
      "expect": { "installed": ["notepad"], "kept": [], "shadowed": [], "deviceReadable": false, "same_as_release": true } },
    { "name": "non-agent device-only entries are dropped (the release is authoritative for system apps)",
      "release": "{\"schema\":1,\"installed\":[{\"id\":\"notepad\",\"enabled\":true}]}",
      "device": "{\"schema\":1,\"installed\":[{\"id\":\"old-bundled\",\"enabled\":true},{\"id\":\"hand-edited\",\"created_by\":\"user\"}]}",
      "expect": { "installed": ["notepad"], "kept": [], "shadowed": [], "deviceReadable": true, "same_as_release": true } },
    { "name": "duplicate agent entries are kept once, first wins",
      "release": "{\"schema\":1,\"installed\":[{\"id\":\"notepad\",\"enabled\":true}]}",
      "device": "{\"schema\":1,\"installed\":[{\"id\":\"mine\",\"created_by\":\"agent\",\"version\":\"1\"},{\"id\":\"mine\",\"created_by\":\"agent\",\"version\":\"2\"}]}",
      "expect": { "installed": ["notepad", "mine"], "kept": ["mine"], "shadowed": [], "deviceReadable": true, "same_as_release": false,
                  "entry": { "id": "mine", "created_by": "agent", "version": "1" } } },
    { "name": "BOM on the device file and CRLF release are handled",
      "release": "{\r\n  \"schema\": 1,\r\n  \"installed\": [\r\n    {\r\n      \"id\": \"notepad\"\r\n    }\r\n  ]\r\n}\r\n",
      "device": "﻿{\"schema\":1,\"installed\":[{\"id\":\"mine\",\"created_by\":\"agent\"}]}",
      "expect": { "installed": ["notepad", "mine"], "kept": ["mine"], "shadowed": [], "deviceReadable": true, "same_as_release": false,
                  "text": "{\r\n  \"schema\": 1,\r\n  \"installed\": [\r\n    {\r\n      \"id\": \"notepad\"\r\n    },\r\n    {\r\n      \"id\": \"mine\",\r\n      \"created_by\": \"agent\"\r\n    }\r\n  ]\r\n}\r\n" } },
    { "name": "entries without a string id are ignored",
      "release": "{\"schema\":1,\"installed\":[{\"id\":\"notepad\"}]}",
      "device": "{\"schema\":1,\"installed\":[{\"created_by\":\"agent\"},{\"id\":7,\"created_by\":\"agent\"},null]}",
      "expect": { "installed": ["notepad"], "kept": [], "shadowed": [], "deviceReadable": true, "same_as_release": true } }
  ]
}
