    "The Guild sends its regards.": { "es": "El Gremio te manda saludos.", "fr": "La Guilde te salue bien.", "de": "Gruesse von der Gilde." },
    "The Lamp forgives. I do not.": { "es": "La Lampara perdona. Yo no.", "fr": "La Lampe pardonne. Pas moi.", "de": "Die Lampe vergibt. Ich nicht." },
    "Nice ship. I'll take it.": { "es": "Bonita nave. Me la quedo.", "fr": "Joli vaisseau. Je le prends.", "de": "Schoenes Schiff. Ich nehm es." },
    "TOO FAST. TOO MANY. STOP.": { "es": "DEMASIADO RAPIDO. PARA.", "fr": "TROP VITE. TROP. ARRETE.", "de": "ZU SCHNELL. ZU VIELE. HALT." },
    "Nothing personal, courier.": { "es": "Nada personal, mensajero.", "fr": "Rien de personnel, coursier.", "de": "Nichts Persoenliches, Kurier." },
    "You wake us. Why?": { "es": "Nos despiertas. Por que?", "fr": "Tu nous reveilles. Pourquoi ?", "de": "Du weckst uns. Warum?" },
    "Mother Ilse": { "es": "Madre Ilse", "fr": "Mere Ilse", "de": "Mutter Ilse" },
    "The Voice": { "es": "La Voz", "fr": "La Voix", "de": "Die Stimme" },
    "The Echo answers.": { "es": "El Eco responde.", "fr": "L'Echo repond.", "de": "Das Echo antwortet." },
    "ACE DOWN": { "es": "AS DERRIBADO", "fr": "AS ABATTU", "de": "ASS ERLEDIGT" },
    "Ambush": { "es": "Emboscada", "fr": "Embuscade", "de": "Hinterhalt" },
    "BRIDGE": { "es": "PUENTE", "fr": "PASSERELLE", "de": "BRUECKE" },
    "Sector": { "es": "Sector", "fr": "Secteur", "de": "Sektor" },
    "cells": { "es": "celdas", "fr": "cell", "de": "Zellen" },
    "range": { "es": "alcance", "fr": "portee", "de": "Weite" },
    "The Costellatori lit the Beacons.": { "es": "Los Costellatori alzaron los Faros.", "fr": "Les Costellatori allument les Phares.", "de": "Die Costellatori schufen die Feuer." },
    "Then the Dimming: they went dark.": { "es": "Luego el Ocaso: se apagaron.", "fr": "Puis le Declin : tout s'eteignit.", "de": "Dann die Verdunkelung: sie erloschen." },
    "Ships jump blind, isle to isle.": { "es": "Se salta a ciegas, isla a isla.", "fr": "On saute a l'aveugle, ile par ile.", "de": "Man springt blind, Insel um Insel." },
    "Ren Calloway, courier. In debt.": { "es": "Ren Calloway, mensajero. Endeudado.", "fr": "Ren Calloway, coursier. Endette.", "de": "Ren Calloway, Kurier. Verschuldet." },
    "Relight the Beacons. The Echo waits.": { "es": "Enciende los Faros. El Eco espera.", "fr": "Rallume les Phares. L'Echo attend.", "de": "Entzuende die Feuer. Das Echo wartet." },
    "One more wreck adrift in the dark.": { "es": "Otro resto a la deriva en lo oscuro.", "fr": "Une epave de plus dans le noir.", "de": "Noch ein Wrack treibt im Dunkel." },
    "Scarlet Gutter's raiders cut your course. They want a toll.": { "es": "Los piratas de Scarlet Gutter cortan tu rumbo. Quieren un peaje.", "fr": "Les pillards de Scarlet Gutter te barrent la route. Ils veulent un peage.", "de": "Scarlet Gutters Pluenderer schneiden dir den Weg. Sie wollen Wegzoll." },
    "Admiral Raske's cruiser locks on. Scanners sweep your illicit hold.": { "es": "El crucero del almirante Raske te fija. Los escaneres barren tu carga.", "fr": "Le croiseur de l'amiral Raske t'accroche. Les scanners fouillent ta soute.", "de": "Admiral Raskes Kreuzer erfasst dich. Scanner durchleuchten deine Fracht." },
    "Mother Ilse offers a warm disc: \"What binds the stars, yet is silent?\"": { "es": "Madre Ilse te da un disco tibio: \"Que une las estrellas y calla?\"", "fr": "Mere Ilse te tend un disque tiede : \"Qu'est-ce qui lie les etoiles et se tait ?\"", "de": "Mutter Ilse reicht dir eine warme Scheibe: \"Was bindet die Sterne und schweigt?\"" },
    "The Voice stirs in the void: \"Pilot. The Beacons are my eyes. Give them back.\"": { "es": "En el vacio despierta la Voz: \"Piloto. Los Faros son mis ojos. Devuelvemelos.\"", "fr": "Dans le vide, la Voix s'eveille : \"Pilote. Les Phares sont mes yeux. Rends-les.\"", "de": "Im Nichts regt sich die Stimme: \"Pilot. Die Feuer sind meine Augen. Gib sie mir.\"" },
    "Below the docks One-Eye Bram grins: cheap contraband, if you have the nerve.": { "es": "Bajo los muelles One-Eye Bram sonrie: contrabando barato, si te atreves.", "fr": "Sous les quais, One-Eye Bram ricane : contrebande pas chere, si tu oses.", "de": "Unter den Docks grinst One-Eye Bram: billige Schmuggelware, wenn du dich traust." }
  }
}
