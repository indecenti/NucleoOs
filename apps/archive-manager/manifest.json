{
  "id": "archive-manager",
  "name": "Archive Manager",
  "version": "1.0.3",
  "version_code": 4,
  "min_os": "0.1.0",
  "platforms": ["esp32s3"],
  "description": "Browse, extract and create archives on the device: ZIP, 7z, RAR, tar and its compressed forms, ISO and more.",
  "category": "tools",
  "runtime": "web",
  "entry_service": "none",
  "web_route": "/apps/archive-manager/",
  "icon": "/apps/archive-manager/icon.svg",
  "permissions": ["storage.shared"],
  "mounts": { "app": "/apps/archive-manager/data" },
  "handles": { "role": "viewer", "extensions": ["zip", "7z", "rar", "tar", "gz", "tgz", "bz2", "tbz", "tbz2", "xz", "txz", "zst", "tzst", "lz4", "lzma", "tlz", "z", "iso", "cab", "cpio", "ar", "deb", "rpm", "xar", "lha", "lzh", "warc"] },
  "subscribes": [],
  "publishes": [],
  "power": { "budget_class": "low", "wants_wakeup": ["keyboard"] },
  "mesh": { "exposes": [], "consumes": [] }
}
