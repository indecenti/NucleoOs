# =============================================================================
# Secrets — never commit keys or credentials
# =============================================================================
# ANIMA teacher key (Groq/Claude/Grok/Gemini) and its backups
tools/anima/.teacher*.json
**/teacher.json
# Keys dropped as text files / dedicated extension
GEMINI API KEY*.txt
*API KEY*.txt
*.apikey
# Session/auth cookies
/devcookie.txt
/*cookie*.txt
# Local release notes: device hosts/PINs (pairing)
tools/release.local.json
tools/*.local.json

# =============================================================================
# Build output, logs and caches (all regenerable)
# =============================================================================
# Host-gate executables, fixtures and screenshots (tools/*-host, ui-host, web-e2e, ...)
/build/
tools/*-host/build/
# Release build output
/dist/
windows-app/dist/
# Python bytecode
__pycache__/
*.pyc
# Build / flash / serial / sync logs
*.log
/_flash_log.txt
# Personal scratch space — keep it local
/_scratch/
# Host-harness scratch root: a throwaway SD mirror the ANIMA gate builds while running
tools/anima-host/d192root/
# Game Boy reference test ROMs, fetched SHA-256-pinned by tools/emu-host/gb-accuracy.mjs
tools/emu-host/testroms/
# Assembled SD master from tools/nucleo-sd-deploy (~1.7 GB) and its auto-saved reports
/deploy/sd-master/
/tools/nucleo-sd-deploy/reports/
# Local device-state backups taken during deploys (personal learned data, sessions)
/deploy/_backups/
/deploy/_state-orphans-backup/

# =============================================================================
# Copyrighted or personal media — never committed
# =============================================================================
# Converted .nfv videos are converter output; third-party films are copyrighted
tools/nfv/out/
*.nfv

# Non-distributable device SD content (kept LOCALLY, never committed): copyrighted game ROMs,
# DOS bundles, media and personal user data. The distributable SD tree is deploy/sd-safe
# (manifests only); deploy/sd and tools/sd-sim are dev cards.
# ROM library: ignore the GAME FILES but keep the empty folder skeleton + README, so a fresh
# clone still ships the tree that first-boot provisioning mirrors onto a blank card.
deploy/sd/data/ROMs/**
!deploy/sd/data/ROMs/
!deploy/sd/data/ROMs/*/
!deploy/sd/data/ROMs/**/.gitkeep
!deploy/sd/data/ROMs/README.txt
deploy/sd/data/DOS/
deploy/sd/data/Documents/
deploy/sd/data/Notes/
deploy/sd/data/Recordings/
deploy/sd/data/Videos/
deploy/sd/data/Saves/
deploy/sd/data/ir/userdata.json
deploy/sd/data/*.txt
deploy/sd/data/*.todo
deploy/sd/data/*.md
tools/sd-sim/data/ROMs/
tools/sd-sim/data/DOS/
tools/sd-sim/data/Documents/
tools/sd-sim/data/Notes/
tools/sd-sim/data/Recordings/
tools/sd-sim/data/Videos/
tools/sd-sim/data/Saves/
tools/sd-sim/data/ir/userdata.json
tools/sd-sim/data/*.txt
tools/sd-sim/data/*.todo
tools/sd-sim/data/*.md

# EmulatorJS runtime is vendored ONCE at apps/arcade/www/emulatorjs (the source of truth).
# deploy/sd is a staging tree that tools/deploy.ps1 regenerates from apps/, so committing the
# 20 MB copy there would duplicate every core blob in the repo for no gain.
deploy/sd/apps/arcade/www/emulatorjs/

# =============================================================================
# Vendored third-party reference trees — cloned locally, never committed
# (see reference/README.md for upstreams and licenses)
# =============================================================================
reference/*
!reference/README.md

# Rebuilt oversized binaries — fetched by oversized-assets/rejoin.mjs, never committed
# (TTS voice packs from a GitHub Release; the Forge GGUF streams from Hugging Face)
deploy/sd-safe/data/tts/**/clips.pcm
deploy/sd-safe/apps/anima/www/forge/models/**/*.gguf
tools/anima/.cache/teacher_*.npy
oversized-assets/parts/qwen-coder-gguf/
oversized-assets/parts/teacher-npy/

# Cached paired session per device for the dev tools (tools/lib/device-session.mjs) — a secret
tools/.device-sessions.json
